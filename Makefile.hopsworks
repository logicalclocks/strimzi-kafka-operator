# Makefile.hopsworks - Re-tag Strimzi images with Hopsworks version suffix
#
# Supports multi-architecture builds with manifest lists.
#
# Usage:
#   Per-architecture (call once per arch, then create manifests):
#     DOCKER_ARCHITECTURE=amd64 make -f Makefile.hopsworks docker_retag docker_push
#     DOCKER_ARCHITECTURE=arm64 make -f Makefile.hopsworks docker_retag docker_push
#     MANIFEST_ARCHITECTURES=amd64,arm64 make -f Makefile.hopsworks docker_amend_manifest
#
#   Single architecture (legacy):
#     make -f Makefile.hopsworks docker_retag docker_push

TOPDIR=$(dir $(lastword $(MAKEFILE_LIST)))

DOCKER_CMD         ?= docker
DOCKER_REGISTRY    ?= docker.io
DOCKER_ORG         ?= strimzi
BUILD_TAG          ?= latest

# Read versions from files
RELEASE_VERSION    ?= $(shell cat $(TOPDIR)/release.version | tr -d '[:space:]')
HOPSWORKS_VERSION  ?= $(shell cat $(TOPDIR)/hopsworks.version | tr -d '[:space:]')

# Combined version tag: e.g., 0.45.1-h1
HOPSWORKS_TAG      = $(RELEASE_VERSION)-$(HOPSWORKS_VERSION)

# Multi-architecture support
ifdef DOCKER_ARCHITECTURE
  DOCKER_PLATFORM_TAG_SUFFIX = -$(DOCKER_ARCHITECTURE)
endif

# Comma-separated list of architectures to include in manifest lists
MANIFEST_ARCHITECTURES ?= $(DOCKER_ARCHITECTURE)

# Get supported Kafka versions from kafka-versions.yaml
KAFKA_VERSIONS      = $(shell yq eval '.[] | select(.supported == true) | .version' $(TOPDIR)/kafka-versions.yaml)

# Simple images (without Kafka version suffix)
SIMPLE_IMAGES      = operator maven-builder kaniko-executor

.PHONY: all docker_retag docker_push docker_amend_manifest \
        docker_retag_simple docker_retag_kafka \
        docker_push_simple docker_push_kafka \
        docker_amend_manifest_simple docker_amend_manifest_kafka \
        guard_manifest_architectures show

all: docker_retag docker_push

# Re-tag all images
docker_retag: docker_retag_simple docker_retag_kafka

# Push all re-tagged images
docker_push: docker_push_simple docker_push_kafka

# Create and push manifest lists for all images
docker_amend_manifest: docker_amend_manifest_simple docker_amend_manifest_kafka

# ─── Re-tag ──────────────────────────────────────────────────────────────────

docker_retag_simple:
	@echo "Re-tagging simple images: $(HOPSWORKS_TAG)$(DOCKER_PLATFORM_TAG_SUFFIX)"
	@for image in $(SIMPLE_IMAGES); do \
		echo "  strimzi/$$image:$(BUILD_TAG)$(DOCKER_PLATFORM_TAG_SUFFIX) -> $(DOCKER_REGISTRY)/$(DOCKER_ORG)/$$image:$(HOPSWORKS_TAG)$(DOCKER_PLATFORM_TAG_SUFFIX)"; \
		$(DOCKER_CMD) tag strimzi/$$image:$(BUILD_TAG)$(DOCKER_PLATFORM_TAG_SUFFIX) $(DOCKER_REGISTRY)/$(DOCKER_ORG)/$$image:$(HOPSWORKS_TAG)$(DOCKER_PLATFORM_TAG_SUFFIX); \
	done

docker_retag_kafka:
	@echo "Re-tagging Kafka images: $(HOPSWORKS_TAG)$(DOCKER_PLATFORM_TAG_SUFFIX)"
	@for kafka_version in $(KAFKA_VERSIONS); do \
		echo "  strimzi/kafka:build-kafka-$$kafka_version$(DOCKER_PLATFORM_TAG_SUFFIX) -> $(DOCKER_REGISTRY)/$(DOCKER_ORG)/kafka:$(HOPSWORKS_TAG)-kafka-$$kafka_version$(DOCKER_PLATFORM_TAG_SUFFIX)"; \
		$(DOCKER_CMD) tag strimzi/kafka:build-kafka-$$kafka_version$(DOCKER_PLATFORM_TAG_SUFFIX) $(DOCKER_REGISTRY)/$(DOCKER_ORG)/kafka:$(HOPSWORKS_TAG)-kafka-$$kafka_version$(DOCKER_PLATFORM_TAG_SUFFIX); \
	done

# ─── Push ────────────────────────────────────────────────────────────────────

docker_push_simple:
	@echo "Pushing simple images: $(HOPSWORKS_TAG)$(DOCKER_PLATFORM_TAG_SUFFIX)"
	@for image in $(SIMPLE_IMAGES); do \
		echo "  $(DOCKER_REGISTRY)/$(DOCKER_ORG)/$$image:$(HOPSWORKS_TAG)$(DOCKER_PLATFORM_TAG_SUFFIX)"; \
		$(DOCKER_CMD) push $(DOCKER_REGISTRY)/$(DOCKER_ORG)/$$image:$(HOPSWORKS_TAG)$(DOCKER_PLATFORM_TAG_SUFFIX); \
	done

docker_push_kafka:
	@echo "Pushing Kafka images: $(HOPSWORKS_TAG)$(DOCKER_PLATFORM_TAG_SUFFIX)"
	@for kafka_version in $(KAFKA_VERSIONS); do \
		echo "  $(DOCKER_REGISTRY)/$(DOCKER_ORG)/kafka:$(HOPSWORKS_TAG)-kafka-$$kafka_version$(DOCKER_PLATFORM_TAG_SUFFIX)"; \
		$(DOCKER_CMD) push $(DOCKER_REGISTRY)/$(DOCKER_ORG)/kafka:$(HOPSWORKS_TAG)-kafka-$$kafka_version$(DOCKER_PLATFORM_TAG_SUFFIX); \
	done

# ─── Manifest create and push ───────────────────────────────────────────────

guard_manifest_architectures:
	@if [ -z "$(MANIFEST_ARCHITECTURES)" ]; then \
		echo "Error: MANIFEST_ARCHITECTURES is empty. Set MANIFEST_ARCHITECTURES or DOCKER_ARCHITECTURE before running manifest targets." >&2; \
		exit 1; \
	fi

docker_amend_manifest_simple: guard_manifest_architectures
	@echo "Creating and pushing manifest lists for simple images: $(HOPSWORKS_TAG)"
	@for image in $(SIMPLE_IMAGES); do \
		echo "  $(DOCKER_REGISTRY)/$(DOCKER_ORG)/$$image:$(HOPSWORKS_TAG)"; \
		sources="" ; \
		for arch in $$(echo "$(MANIFEST_ARCHITECTURES)" | tr ',' ' '); do \
			sources="$$sources $(DOCKER_REGISTRY)/$(DOCKER_ORG)/$$image:$(HOPSWORKS_TAG)-$$arch" ; \
		done ; \
		$(DOCKER_CMD) buildx imagetools create -t $(DOCKER_REGISTRY)/$(DOCKER_ORG)/$$image:$(HOPSWORKS_TAG) $$sources ; \
	done

docker_amend_manifest_kafka: guard_manifest_architectures
	@echo "Creating and pushing manifest lists for Kafka images: $(HOPSWORKS_TAG)"
	@for kafka_version in $(KAFKA_VERSIONS); do \
		echo "  $(DOCKER_REGISTRY)/$(DOCKER_ORG)/kafka:$(HOPSWORKS_TAG)-kafka-$$kafka_version"; \
		sources="" ; \
		for arch in $$(echo "$(MANIFEST_ARCHITECTURES)" | tr ',' ' '); do \
			sources="$$sources $(DOCKER_REGISTRY)/$(DOCKER_ORG)/kafka:$(HOPSWORKS_TAG)-kafka-$$kafka_version-$$arch" ; \
		done ; \
		$(DOCKER_CMD) buildx imagetools create -t $(DOCKER_REGISTRY)/$(DOCKER_ORG)/kafka:$(HOPSWORKS_TAG)-kafka-$$kafka_version $$sources ; \
	done

# ─── Show (dry run) ─────────────────────────────────────────────────────────

show:
	@echo "Build Tag:              $(BUILD_TAG)"
	@echo "Release Version:        $(RELEASE_VERSION)"
	@echo "Hopsworks Version:      $(HOPSWORKS_VERSION)"
	@echo "Combined Tag:           $(HOPSWORKS_TAG)"
	@echo "Docker Registry:        $(DOCKER_REGISTRY)"
	@echo "Docker Org:             $(DOCKER_ORG)"
	@echo "Architecture:           $(DOCKER_ARCHITECTURE)"
	@echo "Platform Tag Suffix:    $(DOCKER_PLATFORM_TAG_SUFFIX)"
	@echo "Manifest Architectures: $(MANIFEST_ARCHITECTURES)"
	@echo ""
	@echo "Simple images:"
	@for image in $(SIMPLE_IMAGES); do \
		echo "  strimzi/$$image:$(BUILD_TAG)$(DOCKER_PLATFORM_TAG_SUFFIX) -> $(DOCKER_REGISTRY)/$(DOCKER_ORG)/$$image:$(HOPSWORKS_TAG)$(DOCKER_PLATFORM_TAG_SUFFIX)"; \
	done
	@echo ""
	@echo "Kafka images:"
	@for kafka_version in $(KAFKA_VERSIONS); do \
		echo "  strimzi/kafka:build-kafka-$$kafka_version$(DOCKER_PLATFORM_TAG_SUFFIX) -> $(DOCKER_REGISTRY)/$(DOCKER_ORG)/kafka:$(HOPSWORKS_TAG)-kafka-$$kafka_version$(DOCKER_PLATFORM_TAG_SUFFIX)"; \
	done
