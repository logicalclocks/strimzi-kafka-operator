# Makefile.hopsworks - Re-tag Strimzi images with Hopsworks version suffix
#
# This Makefile re-tags existing Strimzi images with a Hopsworks-specific version suffix
# to track security fixes in base images without changing Strimzi code.
#
# Usage:
#   make -f Makefile.hopsworks docker_retag       # Re-tag all images locally
#   make -f Makefile.hopsworks docker_push        # Push re-tagged images to registry
#   make -f Makefile.hopsworks all                # Re-tag and push

TOPDIR=$(dir $(lastword $(MAKEFILE_LIST)))

DOCKER_CMD         ?= docker
DOCKER_REGISTRY    ?= docker.io
DOCKER_ORG         ?= strimzi
BUILD_TAG          ?= latest

# Read versions from files
RELEASE_VERSION    ?= $(shell cat $(TOPDIR)/release.version | tr -d '[:space:]')
HOPSWORKS_VERSION  ?= $(shell cat $(TOPDIR)/hopsworks.version | tr -d '[:space:]')

# Combined version tag: e.g., 0.45.1-h1
HOPSWORKS_TAG      = $(RELEASE_VERSION)-$(HOPSWORKS_VERSION)

# Get supported Kafka versions from kafka-versions.yaml
KAFKA_VERSIONS     = $(shell yq eval '.[] | select(.supported == true) | .version' $(TOPDIR)/kafka-versions.yaml)

# Simple images (without Kafka version suffix)
SIMPLE_IMAGES      = operator maven-builder kaniko-executor

.PHONY: all docker_retag docker_push docker_retag_simple docker_retag_kafka docker_push_simple docker_push_kafka

all: docker_retag docker_push

# Re-tag all images
docker_retag: docker_retag_simple docker_retag_kafka

# Push all re-tagged images
docker_push: docker_push_simple docker_push_kafka

# Re-tag simple images (operator, maven-builder, kaniko-executor)
docker_retag_simple:
	@echo "Re-tagging simple images with Hopsworks version: $(HOPSWORKS_VERSION)"
	@for image in $(SIMPLE_IMAGES); do \
		echo "Re-tagging strimzi/$$image:$(BUILD_TAG) -> $(DOCKER_REGISTRY)/$(DOCKER_ORG)/$$image:$(HOPSWORKS_TAG)"; \
		$(DOCKER_CMD) tag strimzi/$$image:$(BUILD_TAG) $(DOCKER_REGISTRY)/$(DOCKER_ORG)/$$image:$(HOPSWORKS_TAG); \
	done

# Re-tag Kafka images for all supported Kafka versions
docker_retag_kafka:
	@echo "Re-tagging Kafka images with Hopsworks version: $(HOPSWORKS_VERSION)"
	@for kafka_version in $(KAFKA_VERSIONS); do \
		echo "Re-tagging strimzi/kafka:build-kafka-$$kafka_version -> $(DOCKER_REGISTRY)/$(DOCKER_ORG)/kafka:$(HOPSWORKS_TAG)-kafka-$$kafka_version"; \
		$(DOCKER_CMD) tag strimzi/kafka:build-kafka-$$kafka_version $(DOCKER_REGISTRY)/$(DOCKER_ORG)/kafka:$(HOPSWORKS_TAG)-kafka-$$kafka_version; \
	done

# Push simple images
docker_push_simple:
	@echo "Pushing simple images with Hopsworks version: $(HOPSWORKS_VERSION)"
	@for image in $(SIMPLE_IMAGES); do \
		echo "Pushing $(DOCKER_REGISTRY)/$(DOCKER_ORG)/$$image:$(HOPSWORKS_TAG)"; \
		$(DOCKER_CMD) push $(DOCKER_REGISTRY)/$(DOCKER_ORG)/$$image:$(HOPSWORKS_TAG); \
	done

# Push Kafka images for all supported Kafka versions
docker_push_kafka:
	@echo "Pushing Kafka images with Hopsworks version: $(HOPSWORKS_VERSION)"
	@for kafka_version in $(KAFKA_VERSIONS); do \
		echo "Pushing $(DOCKER_REGISTRY)/$(DOCKER_ORG)/kafka:$(HOPSWORKS_TAG)-kafka-$$kafka_version"; \
		$(DOCKER_CMD) push $(DOCKER_REGISTRY)/$(DOCKER_ORG)/kafka:$(HOPSWORKS_TAG)-kafka-$$kafka_version; \
	done

# Show what would be tagged (dry run)
show:
	@echo "Build Tag:   $(BUILD_TAG)"
	@echo "Release Version:   $(RELEASE_VERSION)"
	@echo "Hopsworks Version: $(HOPSWORKS_VERSION)"
	@echo "Combined Tag:      $(HOPSWORKS_TAG)"
	@echo "Docker Registry:   $(DOCKER_REGISTRY)"
	@echo "Docker Org:        $(DOCKER_ORG)"
	@echo ""
	@echo "Simple images to re-tag:"
	@for image in $(SIMPLE_IMAGES); do \
		echo "  strimzi/$$image:$(BUILD_TAG) -> $(DOCKER_REGISTRY)/$(DOCKER_ORG)/$$image:$(HOPSWORKS_TAG)"; \
	done
	@echo ""
	@echo "Kafka images to re-tag:"
	@for kafka_version in $(KAFKA_VERSIONS); do \
		echo "  strimzi/kafka:build-kafka-$$kafka_version -> $(DOCKER_REGISTRY)/$(DOCKER_ORG)/kafka:$(HOPSWORKS_TAG)-kafka-$$kafka_version"; \
	done
